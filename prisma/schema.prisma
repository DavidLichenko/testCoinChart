datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------- ENUMS --------------------

enum OrderStatus {
  PENDING
  SUCCESSFUL
  CANCELLED
}

enum TradeTransactionType {
  BUY
  SELL
}

enum OrderType {
  DEPOSIT
  WITHDRAW
}

enum TradeTransactionStatus {
  OPEN
  CLOSE
}

enum UserRole {
  USER
  OWNER
  CR_MANAGMENT
  WORKER
  TEAMLEAD
}

enum UserMessage {
  USER
  SUPPORT
}

enum AssetType {
  IEX
  Crypto
  Forex
  Metal
}

enum AssetType2 {
  FIAT
  CRYPTO
  METAL
  COMMODITY
}

enum UserStatus {
  WRONGNUMBER
  WRONGINFO
  CALLBACK
  LOWPOTENTIONAL
  HIGHPOTENTIONAL
  NOTINTERESTED
  DEPOSIT
  TRASH
  DROP
  NEW
  RESIGN
  COMPLETED
}

// Базовая фиатная валюта пользователя (для отображения баланса)
enum FiatCurrency {
  USD
  EUR
}

// Типы транзакций кошелька
enum WalletTransactionType {
  DEPOSIT // пополнение
  WITHDRAW // вывод
  INTERNAL_TRANSFER // перевод между пользователями
  EXCHANGE // обмен одного актива на другой
  STAKE_LOCK // ушло в стейкинг
  STAKE_UNLOCK // вернулось из стейкинга
  STAKE_REWARD // награда за стейкинг
}

// Статусы транзакций кошелька
enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

// Статус позиции стейкинга
enum StakingStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PayoutAddressType {
  DEPOSIT // адрес только для депозитов
  WITHDRAW // адрес только для выводов
  BOTH // общий адрес и для депозитов, и для выводов
}

// Статус реферальной связи
enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  CANCELLED
}

// Типы уведомлений
enum NotificationType {
  SYSTEM
  TRADE
  ORDER
  WALLET
  REFERRAL
  CHAT
  VERIFICATION
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  password            String?
  emailVerified       DateTime?
  image               String?
  accounts            Account[]
  sessions            Session[]
  user_crypto_address String?
  deposit_message     String?
  withdraw_error      String?
  can_withdraw        Boolean              @default(true)
  blocked             Boolean              @default(false)
  isVerif             Boolean              @default(false)
  TotalBalance        Float?               @default(0)
  assignedTo          String?
  assignedAgentTo     String?
  balance             Balances?
  comments            Comments?
  messages            Message[]
  orders              Orders[]
  trade_transaction   Trade_Transaction[]
  verification        Verification[]
  status              UserStatus           @default(NEW)
  role                UserRole             @default(USER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  Authenticator       Authenticator[]
  PasswordResetToken  PasswordResetToken[]
  chartDrawings       ChartDrawing[]

  // Новые поля/связи:
  aiTrading    Boolean      @default(false)
  mobileNumber String?
  baseCurrency FiatCurrency @default(EUR) // базовая валюта отображения (USD/EUR)

  favoriteTickers         FavoriteTicker[]
  favoriteClientsAsAgent  FavoriteClient[] @relation("AgentFavorites")
  favoriteClientsAsClient FavoriteClient[] @relation("ClientFavorites")

  walletBalances         WalletBalance[]
  walletTransactions     WalletTransaction[] @relation("UserWalletTransactions")
  walletTransactionsFrom WalletTransaction[] @relation("WalletTransactionFromUser")
  walletTransactionsTo   WalletTransaction[] @relation("WalletTransactionToUser")

  stakingPositions StakingPosition[]
  notifications    Notification[]

  referralsSent     Referral[] @relation("ReferralsSent")
  referralsReceived Referral[] @relation("ReferralsReceived")
  referralCode      String?
}

model ChartDrawing {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  timeframe String // "1m", "5m", "15m", "1h", "4h", "1d" и т.д.
  drawings  Json // массив твоих объектов {type,x1,y1,x2,y2,color,...}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol, timeframe])
}

model PayoutAddress {
  id         String @id @default(cuid())
  settingsId Int

  assetSymbol String? // "BTC", "ETH", "USDT", "EUR" и т.д. (можешь связать с CryptoAsset, если хочешь)
  network     String // "TRC20", "ERC20", "BEP20", "BTC", "SEPA" и т.п.
  address     String // сам адрес/реквизиты
  label       String? // для удобства: "Основной USDT TRC20", "Реквизиты EUR SEPA"
  type        PayoutAddressType @default(WITHDRAW)
  isActive    Boolean           @default(true)
  isDefault   Boolean           @default(false)
  minAmount   Float? // минимальная сумма для этого адреса (если нужно)
  maxAmount   Float? // максимальная сумма (если нужно)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  settings Settings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([settingsId])
  @@index([assetSymbol, network, type])
}

model Orders {
  id             String      @id @default(cuid())
  status         OrderStatus
  type           OrderType
  amount         Float
  userId         String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  depositFrom    String?
  bankName       String?
  cardNumber     String?
  cryptoAddress  String?
  cryptoNetwork  String?
  withdrawMethod String?
  User           User        @relation(fields: [userId], references: [id])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime? @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Message {
  id               String   @id @default(cuid())
  content          String
  imageUrl         String?
  isSupportMessage Boolean  @default(false)
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
}

model Balances {
  userId String @id
  usd    Float  @default(0)
  eur    Float  @default(0) // новое поле для евро-баланса

  User User @relation(fields: [userId], references: [id])
}

model Verification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  frontIdUrl String
  backIdUrl  String
  address    String?
  city       String?
  postalCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId])
}

model DepositAddress {
  id        String   @id @default(cuid())
  network   String   @unique // e.g., Bitcoin, Ethereum (ERC20), Tether (TRC20)
  address   String
  qrCodeUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Asset {
  symbol     String     @id // "BTC", "ETH", "USDT"
  name       String
  decimals   Int        @default(8)
  type       AssetType2
  isEnabled  Boolean    @default(true)
  isStakable Boolean    @default(false) // ← ВАЖНО: только stakable-активы доступны для стейкинга
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  walletBalances     WalletBalance[]
  walletTransactions WalletTransaction[]
  stakingPositions   StakingPosition[]
  stakingPlans       StakingPlan[]
}

model StakingPlan {
  id          String   @id @default(cuid())
  name        String
  assetSymbol String
  duration    Int
  apr         Float
  minAmount   Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  asset            Asset             @relation(fields: [assetSymbol], references: [symbol])
  stakingPositions StakingPosition[] // ← ОБЯЗАТЕЛЬНО ДОБАВИЛИ
}

model Settings {
  id              Int             @id @default(autoincrement())
  siteName        String          @default("AragonTrade")
  btcAddress      String?
  ethAddress      String?
  usdtAddress     String?
  usdtNetwork     String          @default("TRC20")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  // НОВОЕ: гибкие адреса для депозитов/выводов
  payoutAddresses PayoutAddress[]
}

model Comments {
  userId   String @id
  messages Json?
  User     User   @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Trade_Transaction {
  id         String                 @id @default(uuid())
  status     TradeTransactionStatus @default(OPEN)
  type       TradeTransactionType
  volume     Float
  margin     Float
  leverage   Int
  profit     Float?
  ticker     String
  openInA    Float
  openIn     Float
  closeIn    Float?
  takeProfit Float?
  stopLoss   Float?
  userId     String
  createdAt  DateTime               @default(now())
  endAt      DateTime?
  assetType  AssetType              @default(IEX)
  isPaid     Boolean                @default(false)
  aiEnabled  Boolean                @default(false)

  User User @relation(fields: [userId], references: [id])
}

// -------------------- НОВЫЕ МОДЕЛИ --------------------

// Избранные тикеры пользователя (для трейд-страницы)
model FavoriteTicker {
  id        String   @id @default(cuid())
  userId    String
  symbol    String // "BTCUSD", "AAPL.NAS", "EURUSD" и т.п.
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId])
}

// Избранные клиенты для агентов (клиенты "в работе")
model FavoriteClient {
  id        String   @id @default(cuid())
  agentId   String
  clientId  String
  createdAt DateTime @default(now())

  agent  User @relation("AgentFavorites", fields: [agentId], references: [id], onDelete: Cascade)
  client User @relation("ClientFavorites", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([agentId, clientId])
  @@index([agentId])
  @@index([clientId])
}

// Балансы кошелька на пользователя и актив
model WalletBalance {
  id          String @id @default(cuid())
  userId      String
  assetSymbol String

  ownBalance  Float @default(0)
  creditLimit Float @default(0)
  creditUsed  Float @default(0)
  locked      Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetSymbol], references: [symbol])

  @@unique([userId, assetSymbol])
  @@index([userId])
  @@index([assetSymbol])
}

model FxRate {
  symbol       String   @id // "USD", "BTC", "ETH"
  toBase       Float // курс к базе сайта
  baseCurrency String   @default("EUR")
  updatedAt    DateTime @updatedAt
}

model WalletTransaction {
  id             String                  @id @default(cuid())
  userId         String // "владелец" транзакции, кто видит её у себя в истории
  assetSymbol    String
  type           WalletTransactionType
  status         WalletTransactionStatus @default(PENDING)
  amount         Float // >0
  fromUserId     String? // для INTERNAL_TRANSFER
  toUserId       String? // для INTERNAL_TRANSFER
  relatedOrderId String? // связь с Orders.id при необходимости
  txHash         String? // on-chain hash
  metadata       Json?
  createdAt      DateTime                @default(now())

  user     User  @relation("UserWalletTransactions", fields: [userId], references: [id], onDelete: Cascade)
  asset    Asset @relation(fields: [assetSymbol], references: [symbol])
  fromUser User? @relation("WalletTransactionFromUser", fields: [fromUserId], references: [id])
  toUser   User? @relation("WalletTransactionToUser", fields: [toUserId], references: [id])

  @@index([userId, createdAt])
  @@index([fromUserId])
  @@index([toUserId])
}

// Стейкинг позиции
model StakingPosition {
  id           String        @id @default(cuid())
  userId       String
  assetSymbol  String
  amount       Float
  planId       String
  rewardRate   Float
  startedAt    DateTime      @default(now())
  endsAt       DateTime?
  status       StakingStatus @default(ACTIVE)
  lastRewardAt DateTime?

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset       @relation(fields: [assetSymbol], references: [symbol])
  plan  StakingPlan @relation(fields: [planId], references: [id]) // связь уже двусторонняя

  @@index([userId, status])
}

// Реферальная система
model Referral {
  id             String         @id @default(cuid())
  referrerId     String // кто пригласил
  referredUserId String // кого пригласили
  code           String? // реф-код или ссылка
  rewardAmount   Float          @default(0)
  rewardCurrency String         @default("USD")
  status         ReferralStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  referrer     User @relation("ReferralsSent", fields: [referrerId], references: [id])
  referredUser User @relation("ReferralsReceived", fields: [referredUserId], references: [id])

  @@unique([referredUserId]) // один реферер на пользователя
  @@index([referrerId])
}

// Уведомления пользователю
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}
